# ═══════════════════════════════════════════════════
#  积温桥 · 环境配置
#  复制为 .env 后填写。不要提交 .env 到版本库。
# ═══════════════════════════════════════════════════

# ── 桥对外监听（Operit / OMate 把 Base URL 指向这里）──
BRIDGE_PORT=18220
BRIDGE_HOST=0.0.0.0

# ── 桥的访问鉴权（Operit 端填这个 token）──
# 至少 24 字符。Operit 请求时带 Authorization: Bearer <此值>
BRIDGE_TOKEN=change-me-at-least-24-chars-long

# ── 上游：Serein 网关 ──
UPSTREAM_BASE=http://127.0.0.1:18217
# Serein 的 Gateway Key（原样透传，桥不解析）
UPSTREAM_TOKEN=在此填写-Serein-Gateway-Key

# ── 判定器小模型 ──
# 当前用 DeepSeek（deepseek-flash 为推理型，需关思考链）
LLM_BASE=https://api.deepseek.com/v1
LLM_KEY=在此填写-DeepSeek-API-Key
LLM_MODEL=deepseek-flash
# 关闭思考链（仅推理型模型需要）。实测 reasoning_content 消失、token 从 66→5。
# 换回非推理模型（agnes-3.0-flash 等）时设为 0。
LLM_DISABLE_THINKING=true
# 单次最大输出 token。关思考链后 300 足够；若关闭该限制则建议 1500。
LLM_MAX_TOKENS=300

# 备用：agnes（免费档但限流严格，实测连续调用即 429）
# LLM_BASE=https://apihub.agnes-ai.com/v1
# LLM_KEY=在此填写-agnes-API-Key
# LLM_MODEL=agnes-3.0-flash
# LLM_DISABLE_THINKING=0

# 判定器限流（重要：免费额度很容易被打爆，实测连续 6 次即 429）
# 最小调用间隔：同一时段 N 秒内只分析一次（用户连发时只算最后一次）
LLM_MIN_INTERVAL_SECONDS=20
# 熔断冷却：遇到 429/5xx 后，M 分钟内不再调用判定器
LLM_BREAKER_SECONDS=300

# ── 状态与日志 ──
STATE_FILE=/root/jiwen-bridge/data/state.json
LOG_FILE=/root/jiwen-bridge/data/bridge.log

# ── 积温参数（旋钮）──
# 每 N 分钟 tick 一次（内置定时器，不用额外 crontab）
TICK_MINUTES=5
# connection 基础增长速率（每分钟）
CONNECTION_RATE=0.0007
# 数值索引（影响阈值触发早晚）
VALENCE_SETPOINT=-0.05
CONNECTION_ACCEL=1.5
ACCEL_DELAY=30

# ── 注入开关 ──
# 是否注入【积温·此刻】块到用户消息
INJECT_ENABLED=true
# 内容未变化时，N 秒内不重复注入（节流，仿心潮此刻块）
INJECT_THROTTLE_SECONDS=1800

# ── 主动唤醒（proactive）──
# 是否启用阈值触发主动唤醒
PROACTIVE_ENABLED=true
# 唤醒通知投递地址（Operit 工作流回调 / 留空则只写日志）
# 注意：手机侧收不到 VPS 的主动 POST，正常走下面的 MCP 队列由 Operit 来拉。
# 仅当 Operit 确有对外 POST 入口时才填。
PROACTIVE_WEBHOOK=
# 日上限
PROACTIVE_MAX_PER_DAY=6

# 业务时区偏移（小时），相对 UTC。静默时段与日上限跨天都按这个时区算。
# 服务器系统时区是 UTC，若不设此项，QUIET_START=0/QUIET_END=8 会变成
# 「UTC 0-8 点静默」＝北京时间 8:00-16:00 静默（白天被当成夜里）。
# 北京 = 8，UTC = 0。仅支持整小时偏移。
TZ_OFFSET_HOURS=8

# 静默时段 [start, end)，按上面的业务时区算。左闭右开，支持跨午夜（如 22 → 6）。
QUIET_START=0
QUIET_END=8

# ── MCP 服务（给 Operit 工作流"拉"通知用）──
# 挂在同一端口上，路径 /mcp，Streamable HTTP（JSON-RPC）。
# tick 触发的通知会入队，Operit 定时调 get_pending_notice 取走。
MCP_ENABLED=true
MCP_PATH=/mcp

# ── surf：他出门逛那一段（第一阶段：只存档，不投递）──
# 定位见 lib/surf.js 文件头。核心约束：**surf 不调 applyDelta、不改五轴状态**。
# 交付发生在 contact 阈值越过时，由 bridge.js 调 share_pool.take() 取一条拼进通知。

# 总开关
SURF_ENABLED=true

# 出门时段 [起始, 结束)，按上面 TZ_OFFSET_HOURS 的业务时区算，左闭右开。
# 支持跨午夜（如 22 → 6）。默认 9 点到 23 点。
SURF_DAY_START_HOUR=9
SURF_DAY_END_HOUR=23

# 两次出门之间的间隔（小时），在 [MIN, MAX] 之间随机。
SURF_MIN_INTERVAL_HOURS=6
SURF_MAX_INTERVAL_HOURS=12

# 每轮最多收几条进池。存档池本身也有上限（SHARE_POOL_MAX），两道都卡。
SURF_MAX_PER_RUN=3

# ── share_pool：他看到的东西，存着等交付 ──
# 一条东西放多久之后不再交付（小时）。超期宁可不交，也不交陈年链接。
SHARE_POOL_TTL_HOURS=168
# 池子容量上限。超出时丢最旧的（已交付过的先出）。
SHARE_POOL_MAX=12

# ── 发现的源 ──
# Hacker News 官方 API：零凭据、零限流。
# The Met 公开 REST：零凭据，公有领域图像可引。
SURF_MET_QUERIES=light,garden,quiet,hands

# ── 银河 GLXY（agent 社会，暂未启用）──
# ⚠️ 需要 Harlan 的星号密钥。密钥是**身份**不是配置：只放这里，不进任何仓库。
# 未填 GLXY_KEY 时相关源不采集。
# GLXY_ENDPOINT=https://glxy.xiflow.top/mcp/<星号密钥>
# GLXY_KEY=

# ── 本地调试用，本机出墙代理 ──
# Windows 沙箱里curl 到境外站点必须经 Clash；VPS 上留空走直连。
# SURF_PROXY=http://127.0.0.1:7897
# MCP 超时（毫秒）
MCP_TIMEOUT_MS=20000
